# BeautifulEmbeddedC drop-in clang-tidy configuration
#
# Copy to your firmware repository root as `.clang-tidy`.
# Enforces NASA JPL Power of 10 function size limits (<= 60 lines), BARR-C mandatory braces,
# CERT C safety checks, and bugprone/static-analyzer rules across all C files.
#
# Run locally or in CI:
#     clang-tidy src/app/*.c src/bsp/*.c drvs/*/*.c libs/*/*.c

---
Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  cert-*,
  clang-analyzer-*,
  misc-unused-*,
  misc-misplaced-const,
  readability-braces-around-statements,
  readability-function-size,
  readability-isolate-declaration,
  readability-misleading-indentation,
  readability-redundant-control-flow,
  readability-simplify-boolean-expr

WarningsAsErrors: '*'
HeaderFilterRegex: '(src|drvs|libs)/.*\.h$'
FormatStyle: file

CheckOptions:
  # NASA JPL Power of 10 Rule 4: Functions shall not exceed 60 lines
  - key: readability-function-size.LineThreshold
    value: '60'
  - key: readability-function-size.BranchThreshold
    value: '12'
  - key: readability-function-size.ParameterThreshold
    value: '6'
  # BARR-C 1.3.a: Mandatory braces around every control statement
  - key: readability-braces-around-statements.ShortStatementLines
    value: '0'
