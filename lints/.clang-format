# BeautifulEmbeddedC drop-in clang-format configuration
#
# Copy to your firmware repository root as `.clang-format`.
# Enforces BARR-C:2018 Rule 1.3.a (mandatory braces on every if/else/for/while/do/switch)
# and prevents single-line control statements across all layers (app, bsp, config, drv, libs).
#
# Format in place:
#     clang-format -i src/**/*.[ch] drvs/**/*.[ch] libs/**/*.[ch]
#
# Enforce in CI:
#     clang-format --dry-run -Werror src/**/*.[ch] drvs/**/*.[ch] libs/**/*.[ch]

---
BasedOnStyle: LLVM
Language: Cpp
IndentWidth: 4
TabWidth: 4
UseTab: Never
ColumnLimit: 100

# BARR-C 1.3.a: Mandatory braces on every control statement body (requires clang-format >= 15)
BreakBeforeBraces: Attach
InsertBraces: true
AllowShortFunctionsOnASingleLine: None
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortBlocksOnASingleLine: Never
AllowShortCaseLabelsOnASingleLine: false

# Keep pointer stars attached to the identifier (`const DrvPwmConfig_t *configTable`)
PointerAlignment: Right

# Preserve deliberate header include ordering (own module .h first, then standard headers)
SortIncludes: Never
ReflowComments: false
MaxEmptyLinesToKeep: 2
InsertNewlineAtEOF: true
UseCRLF: false
